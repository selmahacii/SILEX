{
  "name": "silex-industrial-erp",
  "version": "1.0.0",
  "private": true,
  "description": "SILEX Industrial ERP - Industrial Project & Operations Management Platform",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @silex/api dev & pnpm --filter @silex/web dev",
    "dev:api": "pnpm --filter @silex/api dev",
    "dev:web": "pnpm --filter @silex/web dev",
    "build": "pnpm --filter @silex/shared build && pnpm --filter @silex/contracts build && pnpm --filter @silex/validation build && pnpm --filter @silex/api build && pnpm --filter @silex/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @silex/api prisma:generate",
    "db:migrate": "pnpm --filter @silex/api prisma:migrate",
    "db:seed": "pnpm --filter @silex/api prisma:seed",
    "db:seed:blank": "pnpm --filter @silex/api prisma:seed:blank",
    "db:studio": "pnpm --filter @silex/api prisma:studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "next": "^15.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
