# ==============================================================
# SILEX INDUSTRIAL ERP - CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# ==============================================================

# Mode démonstration (active le sélecteur de rôles serveur-sécurisé et le bandeau de démo)
DEMO_MODE=true

# Environnement
NODE_ENV=development

# Application Ports
API_PORT=4000
WEB_PORT=3000

# URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL
# En local ou Docker: silex_erp / silex_dev_pass
DATABASE_URL="postgresql://silex_admin:silex_secure_pass_2026@localhost:5432/silex_erp?schema=public"

# Sécurité & Auth (Argon2id + JWT)
JWT_SECRET="silex_super_secret_jwt_key_industrial_erp_2026_demo"
JWT_REFRESH_SECRET="silex_super_refresh_jwt_key_industrial_erp_2026_demo"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Fuseau horaire et paramètres régionaux
TZ="Africa/Algiers"
APP_LOCALE="fr-DZ"
APP_CURRENCY="DA"
